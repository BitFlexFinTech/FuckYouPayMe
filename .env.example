# ─── FuckYouPayMe Environment Variables ─────────────────────────────────────
# Copy this to .env.local and fill in real values

# Database
DATABASE_URL="postgresql://user:password@host:5432/fuckyoupayme?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_CLIENT_ID="ca_..."

# NOWPayments
NOWPAYMENTS_API_KEY="..."
NOWPAYMENTS_IPN_SECRET="..."

# Resend (Email)
RESEND_API_KEY="re_..."

# Twilio (SMS)
TWILIO_ACCOUNT_SID="..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# Sentry (Error Tracking)
SENTRY_DSN="..."

# Web Push (PWA)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:admin@fuckyoupayme.online"

# Cron (for dunning + recurring invoice endpoints)
CRON_SECRET="generate-a-random-secret"

# Platform
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PLATFORM_FEE_PERCENT=2.5